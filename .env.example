# Database — Supabase Session Mode pooler URL. Must include ?connection_limit=1&pgbouncer=true
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?connection_limit=1&pgbouncer=true
DATABASE_URL=

# Database — Direct (non-pooled) connection URL. Used for Prisma migrations only.
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_DATABASE_URL=

# Auth
JWT_SECRET=

# Encryption — 32-byte hex string (AES-256-GCM master key)
AES_KEY=

# Webhook secrets — used for HMAC signature verification
AIRBNB_WEBHOOK_SECRET=
VRBO_WEBHOOK_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Anthropic
ANTHROPIC_API_KEY=

# Sentry
SENTRY_DSN=

# App
FRONTEND_URL=
PORT=
NODE_ENV=
